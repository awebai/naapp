{
  "manifest_version": 2,
  "app": {
    "id": "tasks",
    "version": "0.1.0",
    "origin": "https://tasks.aweb.ai"
  },
  "app_keys": [
    {
      "kid": "tasks:emit-1",
      "purposes": [
        "app-event"
      ]
    },
    {
      "kid": "tasks:grant-read-1",
      "purposes": [
        "app-grant-read"
      ]
    }
  ],
  "events": [
    {
      "type": "task.status",
      "default_delivery_intent": "wake",
      "description": "A task was created, closed or reopened, or its stored status changed. resource_ref is the task number; the payload carries the status only."
    },
    {
      "type": "task.claim",
      "default_delivery_intent": "wake",
      "description": "A task's claim was taken, released, taken over or ended by a close. resource_ref is the task number; the payload carries the claim's revision only."
    },
    {
      "type": "lock",
      "default_delivery_intent": "wake",
      "description": "A lock was taken, released or broken. resource_ref is the resource; the payload carries the lock's revision only."
    }
  ],
  "tools": [
    {
      "name": "create",
      "description": "Create a task. Numbers start at 1 and are never reused.",
      "method": "POST",
      "path": "/v1/tasks",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "task",
              "bug",
              "feature",
              "epic"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parent": {
            "type": "integer"
          },
          "assignee": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "title",
          "in": "body"
        },
        {
          "name": "body",
          "in": "body"
        },
        {
          "name": "type",
          "in": "body"
        },
        {
          "name": "priority",
          "in": "body"
        },
        {
          "name": "labels",
          "in": "body"
        },
        {
          "name": "parent",
          "in": "body"
        },
        {
          "name": "assignee",
          "in": "body"
        }
      ],
      "scopes": [
        "tasks.write"
      ],
      "mutation": true,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "agent"
      ]
    },
    {
      "name": "show",
      "description": "Show one task, with its live claim and dependencies.",
      "method": "GET",
      "path": "/v1/tasks/{number}",
      "input_schema": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer"
          }
        },
        "required": [
          "number"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "number",
          "in": "path"
        }
      ],
      "scopes": [
        "tasks.read"
      ],
      "mutation": false,
      "invocation_contexts": [
        "agent"
      ]
    },
    {
      "name": "list",
      "description": "List tasks, filtered by status, label, assignee, parent, type and priority.",
      "method": "GET",
      "path": "/v1/tasks",
      "input_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "blocked",
              "closed"
            ]
          },
          "label": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "parent": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "task",
              "bug",
              "feature",
              "epic"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "status",
          "in": "query"
        },
        {
          "name": "label",
          "in": "query"
        },
        {
          "name": "assignee",
          "in": "query"
        },
        {
          "name": "parent",
          "in": "query"
        },
        {
          "name": "type",
          "in": "query"
        },
        {
          "name": "priority",
          "in": "query"
        }
      ],
      "scopes": [
        "tasks.read"
      ],
      "mutation": false,
      "invocation_contexts": [
        "agent"
      ]
    },
    {
      "name": "update",
      "description": "Change a task's title, body, type, priority, labels, parent, assignee or status. Closing through update follows close's rules.",
