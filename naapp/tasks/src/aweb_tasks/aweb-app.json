          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parent": {
            "type": "integer"
          },
          "assignee": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "blocked",
              "closed"
            ]
          }
        },
        "required": [
          "number"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "number",
          "in": "path"
        },
        {
          "name": "title",
          "in": "body"
        },
        {
          "name": "body",
          "in": "body"
        },
        {
          "name": "type",
          "in": "body"
        },
        {
          "name": "priority",
          "in": "body"
        },
        {
          "name": "labels",
          "in": "body"
        },
        {
          "name": "parent",
          "in": "body"
        },
        {
          "name": "assignee",
          "in": "body"
        },
        {
          "name": "status",
          "in": "body"
        }
      ],
      "scopes": [
        "tasks.write"
      ],
      "mutation": true,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "agent"
      ]
    },
